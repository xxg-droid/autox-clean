<?xml version="1.0" encoding="utf-8"?>
<!-- build27 UI 改版：文件行改成独立圆角卡片（16dp 圆角，左右边距 12dp，上下间距 6dp）。
     底层是右滑露出的操作按钮（删除 + ⋮），前景卡片右滑后露出它们。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp">

    <!-- 右滑露出的操作按钮（在卡片底层） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/swipe_delete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_swipe_delete"
            android:clickable="true"
            android:contentDescription="@string/text_delete"
            android:padding="12dp"
            android:src="@drawable/ic_delete"
            android:tint="@android:color/white"/>

        <ImageView
            android:id="@+id/swipe_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_swipe_more"
            android:clickable="true"
            android:contentDescription="@string/desc_more"
            android:padding="12dp"
            android:src="@drawable/ic_more_vert_black_24dp"
            android:tint="#A9AAAB"/>

    </LinearLayout>

    <!-- 前景卡片 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/foreground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/item_background_dark"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:id="@+id/item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?selectableItemBackground"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/first_char"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_js_badge"
                android:gravity="center"
                android:textColor="@color/js_badge_text"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="js"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textColor="@color/script_file_name"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="tk-clean.js"/>

                <TextView
                    android:id="@+id/desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textColor="@color/script_file_desc"
                    android:textSize="12sp"
                    tools:text="7.8 KB"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/run"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_play_button"
                    android:clickable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_run_gray"
                    android:tint="@color/play_button_icon"/>

                <ImageView
                    android:id="@+id/edit"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:background="?selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:paddingBottom="8dp"
                    android:paddingTop="8dp"
                    android:src="@drawable/ic_mode_edit_black_24dp"
                    android:tint="#A9AAAB"/>

                <ImageView
                    android:id="@+id/more"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:background="?selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:paddingBottom="8dp"
                    android:paddingTop="8dp"
                    android:src="@drawable/ic_more_vert_black_24dp"
                    android:tint="#A9AAAB"/>

            </LinearLayout>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
